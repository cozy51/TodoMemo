{
  "manifest_version": 3,
  "name": "TodoMemo",
  "version": "1.9.23",
  "description": "今することを、ひとつだけ。シンプルなTodoメモ。",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "TodoMemo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "options_page": "organizer.html"
}
